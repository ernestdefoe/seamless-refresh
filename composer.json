{
  "name": "ernestdefoe/seamless-refresh",
  "description": "Stop Flarum telling members to reload: new assets are picked up on the next click, and a session that ends under an open page recovers instead of failing every action.",
  "keywords": ["flarum", "flarum-extension", "refresh", "assets", "ux"],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/seamless-refresh",
  "support": {
    "forum": "https://discuss.flarum.org/d/39533-seemless-refresh-created-with-ai",
    "issues": "https://github.com/ernestdefoe/seamless-refresh/issues",
    "source": "https://github.com/ernestdefoe/seamless-refresh"
  },
  "require": {
    "flarum/core": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "ErnestDefoe\\SeamlessRefresh\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ErnestDefoe\\SeamlessRefresh\\Tests\\": "tests/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Seamless Refresh",
      "category": "feature",
      "icon": {
        "name": "fas fa-arrows-rotate",
        "backgroundColor": "#5b5bd6",
        "color": "#fff"
      }
    },
    "flarum-cli": {
      "modules": {
        "js": true
      }
    }
  },
  "require-dev": {
    "flarum/phpstan": "^2.0",
    "flarum/testing": "^2.0"
  },
  "scripts": {
    "test": [
      "@test:integration"
    ],
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php",
    "analyse:phpstan": "phpstan analyse"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
    "analyse:phpstan": "Run static analysis"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
